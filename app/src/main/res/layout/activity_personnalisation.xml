<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".PersonnalisationActivity">
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:text="Récapitulatif"
        android:textSize="25dp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="15dp"/>
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/Taille"
        android:text="Taille"
        app:layout_constraintTop_toBottomOf="@+id/title"
        android:layout_marginTop="20dp"
        app:layout_constraintStart_toStartOf="parent"
        android:textStyle="bold"
        android:textSize="20sp"
        android:layout_marginStart="14dp"
        />
    <RadioGroup
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintTop_toBottomOf="@id/Taille"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:id="@+id/radioG"
        android:orientation="horizontal"
        >
        <RadioButton
            android:id="@+id/petit"
            android:layout_height="wrap_content"
            android:layout_width="wrap_content"
            android:text="Petit"
            android:layout_marginEnd="40dp"
            android:textStyle="bold"
            android:textSize="20dp"
            />
        <RadioButton
            android:id="@+id/moyen"
            android:layout_height="wrap_content"
            android:layout_width="wrap_content"
            android:text="Moyen"
            android:checked="true"
            android:textStyle="bold"
            android:layout_marginEnd="40dp"
            android:textSize="20dp"
            />
        <RadioButton
            android:id="@+id/grand"
            android:layout_height="wrap_content"
            android:layout_width="wrap_content"
            android:text="Grand"
            android:textSize="20dp"
            android:textStyle="bold"
            />
    </RadioGroup>
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/supp"
        android:text="Suppléments"
        app:layout_constraintTop_toBottomOf="@+id/radioG"
        android:layout_marginTop="17dp"
        app:layout_constraintStart_toStartOf="parent"
        android:textStyle="bold"
        android:textSize="20sp"
        android:layout_marginStart="14dp"
        />

    <CheckBox
        android:id="@+id/chbox1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginStart="10dp"
        android:textStyle="bold"
        android:textSize="16dp"
        android:text="Sucre"
        app:layout_constraintTop_toBottomOf="@+id/supp"/>
    <CheckBox
        android:id="@+id/chbox2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginStart="10dp"
        android:textStyle="bold"
        android:textSize="16dp"
        android:text="Créme(+2DH)"
        app:layout_constraintTop_toBottomOf="@+id/chbox1"/>
    <CheckBox
        android:id="@+id/chbox3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginStart="10dp"
        android:textStyle="bold"
        android:textSize="16dp"
        android:text="Cannelle(+1DH)"
        app:layout_constraintTop_toBottomOf="@+id/chbox2"/>
    <Switch
        android:layout_width="60dp"
        android:layout_height="wrap_content"
        android:id="@+id/switchemporter"
        app:layout_constraintTop_toBottomOf="@id/chbox3"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBaseline_toBaselineOf="@+id/emporter"
        />
    <TextView
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:id="@+id/emporter"
    android:text="Emporter"
    app:layout_constraintTop_toBottomOf="@+id/chbox3"
    android:layout_marginTop="30dp"
    app:layout_constraintStart_toStartOf="parent"
    android:textStyle="bold"
    android:textSize="20sp"
    android:layout_marginStart="14dp"
    />
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/lait"
        android:text="Lait"
        app:layout_constraintTop_toBottomOf="@+id/emporter"
        android:textSize="20dp"
        app:layout_constraintStart_toStartOf="@+id/Taille"
        android:layout_marginTop="30dp"
        android:textStyle="bold"/>
    <Spinner
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:id="@+id/spinner"
        app:layout_constraintTop_toBottomOf="@+id/lait"
        android:layout_marginTop="30dp"
        app:layout_constraintStart_toStartOf="@+id/Taille"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginEnd="20dp"
        />
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/commond"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="32dp"
        app:layout_constraintBottom_toTopOf="@+id/prix"
        android:textSize="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/spinner"/>

    <TextView
        android:id="@+id/prix"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:textSize="25dp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/commond" />
    <Button
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:id="@+id/calculer"
        android:text="Calculer"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginBottom="10dp"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginEnd="15dp"
        app:layout_constraintStart_toStartOf="@+id/Taille"/>



</androidx.constraintlayout.widget.ConstraintLayout>